{
  "expo": {
    "name": "client",
    "slug": "client",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "client",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para mostrarte los locales más cercanos en el mapa.",
        "NSLocationAlwaysUsageDescription": "Permitir que la app use tu ubicación para mostrar locales cercanos.",
        "NSCameraUsageDescription": "Necesitamos acceso a tu cámara para escanear códigos QR y subir fotos/videos.",
        "NSPhotoLibraryUsageDescription": "Necesitamos acceso a tu galería para subir fotos/videos.",
        "NSFaceIDUsageDescription": "Necesitamos tu huella/cara para iniciar sesión.",
        "NSPhotoLibraryAddUsageDescription": "Permitir que DualEat guarde archivos (como QRs o PDFs) en tu dispositivo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.dualeat.mobile",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "¿Permitir que DualEat acceda a tu ubicación?."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que DualEat acceda a tu cámara."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que DualEat acceda a tu galería de fotos.",
          "cameraPermission": "Permitir que DualEat acceda a tu cámara."
        }
      ],
      "expo-av",
      [
        "expo-notifications",
        {
          "color": "#ffffff"
        }
      ],
      "expo-document-picker",
      "expo-local-authentication",
      "expo-media-library"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "440bb60e-4f46-4f33-86bd-83484779b55c"
      }
    }
  }
}