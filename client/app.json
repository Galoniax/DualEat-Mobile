{
  "expo": {
    "name": "DualEat",
    "slug": "dualeat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dualeat",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dualeat.mobile",
      "associatedDomains": ["applinks:www.dualeat.com"],
      "infoPlist": {
        "UIBackgroundModes": ["fetch"],
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para mostrarte los locales más cercanos en el mapa.",
        "NSLocationAlwaysUsageDescription": "Permitir que la app use tu ubicación para mostrar locales cercanos.",
        "NSCameraUsageDescription": "Necesitamos acceso a tu cámara para escanear códigos QR y subir fotos/videos.",
        "NSPhotoLibraryUsageDescription": "Necesitamos acceso a tu galería para subir fotos/videos.",
        "NSFaceIDUsageDescription": "Necesitamos tu huella/cara para iniciar sesión.",
        "NSPhotoLibraryAddUsageDescription": "Permitir que DualEat guarde archivos (como QRs o PDFs) en tu dispositivo."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyBsi6f0fbxf8qbH0thDFQzpu4pzdXEi4UI"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#404040",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.RECORD_AUDIO"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.dualeat.mobile",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBsi6f0fbxf8qbH0thDFQzpu4pzdXEi4UI"
        }
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.dualeat.com"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "dualeat",
              "host": "callback"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-screen-orientation",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 90,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "¿Permitir que DualEat acceda a tu ubicación?."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que DualEat acceda a tu cámara."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que DualEat acceda a tu galería de fotos.",
          "cameraPermission": "Permitir que DualEat acceda a tu cámara."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ffffff"
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "af8323f4-813e-4ad5-9568-3fa4a494f6ae"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/af8323f4-813e-4ad5-9568-3fa4a494f6ae"
    }
  }
}
